# Server
PORT=3000
# Leave DATABASE_URL empty to use in-memory storage (data resets on restart).
DATABASE_URL=
MONTHLY_RATE=2.49
TERM_MONTHS=36
CONSENT_VERSION=2026-11-zirat-v1

# Staff console login. If ADMIN_PASSWORD is blank the server generates a
# one-off password at boot and prints it to the log.
ADMIN_EMAIL=admin@ziratbank.demo
ADMIN_PASSWORD=

# Contact details. These seed the settings row the owner edits in /admin/settings;
# the stored values win once saved. Anything left blank falls back to the
# demonstration values in lib/settings.js.
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_HOURS=
CONTACT_ADDRESS=

# Build-time contact details for the static landing page. Anything left blank
# falls back to the demonstration values in src/config/site.js.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_ADDRESS=
VITE_CONTACT_WHATSAPP=
VITE_SUPPORT_HOURS=Mon–Fri, 09:00–18:00 GMT

# Analytics (optional). Events fire only when these are set, and never include
# personal data.
VITE_FB_PIXEL_ID=
VITE_GA_ID=
